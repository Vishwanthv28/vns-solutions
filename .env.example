# Backend only. Copy this file to .env.local. Never use VITE_ for API keys.
CONSULTANT_PROVIDER=gemini
GEMINI_API_KEY=
# Set a GenerateContent model available to your account that supports structured JSON.
CONSULTANT_MODEL=gemini-3.8-flash
# Existing contact endpoint (optional for this stage)
RESEND_API_KEY=

# Lead submission: backend only. Run supabase/consultant-leads.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend: verified sender, or onboarding@resend.dev for your own account email.
LEAD_EMAIL_FROM=VNS Solutions <onboarding@resend.dev>
LEAD_EMAIL_TO=vnsolutions28@gmail.com
